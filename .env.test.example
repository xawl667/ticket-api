# Test environment configuration
# Copy to .env.test and adjust if needed

NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5433/tickets_test
JWT_SECRET=test-secret-min-32-chars-abcdefghijklmnop
JWT_ISSUER=ticket-api
JWT_AUDIENCE=ticket-api
APP_URL=http://localhost:3001
RATE_LIMIT_ENABLED=false

# AI / DeepSeek (optional for tests - mocked)
DEEPSEEK_API_KEY=""
AI_MODEL="deepseek-chat"
AI_BASE_URL="https://api.deepseek.com"
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20
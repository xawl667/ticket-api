# Database
DATABASE_URL="postgresql://user:pass@localhost:5433/tickets"

# Server
NODE_ENV="development"
PORT=3000

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_ISSUER="ticket-api"
JWT_AUDIENCE="ticket-api"

# App URL (used for email links)
APP_URL="http://localhost:3000"

# Resend (email service) - required in production
RESEND_API_KEY=""

# Email sender (required in production)
EMAIL_FROM="onboarding@resend.dev"

# Seed Super Admin (remove after running seed)
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="SuperSecurePassword123"
